        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Dinesh Kumar\",\n  \"email\": \"x@example.com\",\n  \"password\": \"Strong@123\",\n  \"confirm_password\": \"Other@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Login - valid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"dk@example.com\",\n  \"password\": \"Strong@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('token', j.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Login - wrong password",
      "request": {
        "method": "POST",
        "header": [
          {
