        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Dinesh Kumar\",\n  \"email\": \"bad-email\",\n  \"password\": \"Strong@123\",\n  \"confirm_password\": \"Strong@123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Register - password mismatch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
