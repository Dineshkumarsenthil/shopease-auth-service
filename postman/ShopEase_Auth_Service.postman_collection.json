          }
        }
      ]
    },
    {
      "name": "11 Me - expired token (paste expired token in header)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer PASTE_EXPIRED_TOKEN_HERE"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
